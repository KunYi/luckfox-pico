From 4d68603e537031e09722c423e94d5079c1ddcda9 Mon Sep 17 00:00:00 2001
From: Kun-Yi Chen <kunyi.chen@gmail.com>
Date: Sun, 27 Jul 2025 13:09:40 +0800
Subject: [PATCH] Replace deprecated /proc/[pid]/oom_adj with
 /proc/[pid]/oom_score_adj

The OOM adjustment interface /proc/[pid]/oom_adj has been deprecated
in newer Linux kernels in favor of /proc/[pid]/oom_score_adj.

Update adb and adbd services.c to use /proc/[pid]/oom_score_adj to set
OOM killer adjustment to zero, avoiding deprecation warnings and
improving compatibility with modern kernels.

Also update related comments to reflect the new interface.
---
 core/adb/services.c  | 6 +++---
 core/adbd/services.c | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/core/adb/services.c b/core/adb/services.c
index 54d21a8..f17a6c9 100644
--- a/core/adb/services.c
+++ b/core/adb/services.c
@@ -308,7 +308,7 @@ static int create_subprocess(const char *cmd, const char *arg0, const char *arg1
 
         // set OOM adjustment to zero
         char text[64];
-        snprintf(text, sizeof text, "/proc/%d/oom_adj", getpid());
+        snprintf(text, sizeof text, "/proc/%d/oom_score_adj", getpid());
         int fd = adb_open(text, O_WRONLY);
         if (fd >= 0) {
             adb_write(fd, "0", 1);
@@ -323,8 +323,8 @@ static int create_subprocess(const char *cmd, const char *arg0, const char *arg1
     } else {
         // Don't set child's OOM adjustment to zero.
         // Let the child do it itself, as sometimes the parent starts
-        // running before the child has a /proc/pid/oom_adj.
-        // """adb: unable to open /proc/644/oom_adj""" seen in some logs.
+        // running before the child has a /proc/pid/oom_score_adj.
+        // """adb: unable to open /proc/644/oom_score_adj""" seen in some logs.
         return ptm;
     }
 #endif /* !HAVE_WIN32_PROC */
diff --git a/core/adbd/services.c b/core/adbd/services.c
index 239f49f..5a9d1b6 100644
--- a/core/adbd/services.c
+++ b/core/adbd/services.c
@@ -316,7 +316,7 @@ static int create_subprocess(const char *cmd, const char *arg0, const char *arg1
 
         // set OOM adjustment to zero
         char text[64];
-        snprintf(text, sizeof text, "/proc/%d/oom_adj", getpid());
+        snprintf(text, sizeof text, "/proc/%d/oom_score_adj", getpid());
         int fd = adb_open(text, O_WRONLY);
         if (fd >= 0) {
             adb_write(fd, "0", 1);
@@ -331,8 +331,8 @@ static int create_subprocess(const char *cmd, const char *arg0, const char *arg1
     } else {
         // Don't set child's OOM adjustment to zero.
         // Let the child do it itself, as sometimes the parent starts
-        // running before the child has a /proc/pid/oom_adj.
-        // """adb: unable to open /proc/644/oom_adj""" seen in some logs.
+        // running before the child has a /proc/pid/oom_score_adj.
+        // """adb: unable to open /proc/644/oom_score_adj""" seen in some logs.
         return ptm;
     }
 #endif /* !HAVE_WIN32_PROC */
